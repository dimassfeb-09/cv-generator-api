# Supabase API Settings
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PostgreSQL Connection Settings
# Use the connection pooler URL (Transaction mode, port 6543)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string -> Pooler
DATABASE_URL=

# Supabase Storage Settings
# The name of the bucket you created in the Storage section
SUPABASE_BUCKET=

GMAIL_USER=
GMAIL_APP_PASSWORD=

JWT_SECRET=

CRON_SECRET=